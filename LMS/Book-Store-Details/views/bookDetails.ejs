<%- include("layouts/header") %>

    <div class="bg-white shadow-xl rounded-lg p-6 flex flex-col md:flex-row gap-6">

        <img src="<%= book.image %>" class="md:w-1/3 rounded-lg">

        <div>
            <h1 class="text-3xl font-bold">
                <%= book.title %>
            </h1>

            <p class="text-gray-600 mt-2">
                Author: <%= book.author %>
            </p>

            <p class="text-green-600 text-2xl font-bold mt-3">
                ₹ <%= book.price %>
            </p>

            <p class="mt-4 text-gray-700">
                <%= book.description %>
            </p>

            <p class="mt-3 text-sm text-gray-500">
                Category: <%= book.category %>
            </p>

            <a href="/" class="inline-block mt-4 bg-gray-600 text-white px-4 py-2 rounded">
                Back to Home
            </a>
        </div>

    </div>

    <%- include("layouts/footer") %>