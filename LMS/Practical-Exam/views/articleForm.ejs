<% include ./navbar %>

<div class="container">
  <h1><%= article ? 'Edit Article' : 'New Article' %></h1>
  <form action="<%= action %>" method="POST">
    <div class="form-group">
      <label for="title">Title:</label>
      <input type="text" id="title" name="title" value="<%= article ? article.title : '' %>" required>
    </div>
    <div class="form-group">
      <label for="content">Content:</label>
      <textarea id="content" name="content" rows="10" required><%= article ? article.content : '' %></textarea>
    </div>
    <button type="submit"><%= article ? 'Update' : 'Create' %></button>
    <a href="/articles" class="btn-cancel">Cancel</a>
  </form>
</div>

<style>
  /* Basic styling for article form */
  .container {
    max-width: 600px;
    margin: 0 auto;
    padding: 20px;
  }
  .form-group {
    margin-bottom: 20px;
  }
  label {
    display: block;
    margin-bottom: 5px;
    font-weight: bold;
  }
  input, textarea {
    width: 100%;
    padding: 10px;
    border: 1px solid #ddd;
    border-radius: 4px;
    box-sizing: border-box;
  }
  input:focus, textarea:focus {
    outline: none;
    border-color: #007bff;
    box-shadow: 0 0 5px rgba(0,123,255,0.5);
  }
  button, .btn-cancel {
    display: inline-block;
    padding: 10px 20px;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    text-decoration: none;
    margin-right: 10px;
  }
  button {
    background-color: #28a745;
    color: white;
  }
  button:hover {
    background-color: #1e7e34;
  }
  .btn-cancel {
    background-color: #6c757d;
    color: white;
    margin-left: 0;
  }
  .btn-cancel:hover {
    background-color: #5a6268;
  }
</style>