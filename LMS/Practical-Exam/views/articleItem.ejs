<% include ./navbar %>

<div class="container">
  <div class="article-header">
    <h1><%= article.title %></h1>
    <p class="article-meta">
      By <span class="author"><%= article.author.username %></span> on 
      <span class="date"><%= article.createdAt.toLocaleDateString() %></span>
    </p>
    <% if (user && (article.author._id.equals(user.userId) || user.role === 'admin')) { %>
      <div class="article-actions">
        <a href="/articles/edit/<%= article._id %>" class="btn-edit">Edit</a>
        <form action="/articles/delete/<%= article._id %>" method="POST" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this article?');">
          <button type="submit" class="btn-delete">Delete</button>
        </form>
      </div>
    <% } %>
  </div>

  <div class="article-content">
    <p><%= article.content %></p>
  </div>

  <div class="comments-section">
    <h2>Comments (<%= article.comments.length %>)</h2>
    <% if (article.comments.length === 0) { %>
      <p>No comments yet.</p>
    <% } else { %>
      <div class="comment-list">
        <% article.comments.forEach(comment => { %>
          <div class="comment-card">
            <p class="comment-content"><%= comment.content %></p>
            <p class="comment-meta">
              By <span class="comment-author"><%= comment.author.username %></span> on 
              <span class="comment-date"><%= comment.createdAt.toLocaleDateString() %></span>
            </p>
            <% if (user && (comment.author._id.equals(user.userId) || user.role === 'admin')) { %>
              <form action="/articles/comment/<%= comment._id %>/delete" method="POST" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this comment?');">
                <button type="submit" class="btn-delete-comment">Delete</button>
              </form>
            <% } %>
          </div>
        <% }); %>
      </div>
    <% } %>

    <% if (user) { %>
      <div class="add-comment">
        <h3>Add a Comment</h3>
        <form action="/articles/<%= article._id %>/comment" method="POST">
          <div class="form-group">
            <label for="comment">Comment:</label>
            <textarea id="comment" name="content" rows="4" required></textarea>
          </div>
          <button type="submit">Post Comment</button>
        </form>
      </div>
    <% } else { %>
      <p><a href="/login">Log in</a> to leave a comment.</p>
    <% %>
  </div>
</div>

<style>
  /* Basic styling for article item */
  .container {
    max-width: 800px;
    margin: 0 auto;
    padding: 20px;
  }
  .article-header {
    border-bottom: 1px solid #eee;
    padding-bottom: 10px;
    margin-bottom: 20px;
  }
  .article-header h1 {
    margin-top: 0;
  }
  .article-meta {
    color: #666;
    font-size: 0.9em;
  }
  .article-actions {
    margin-top: 10px;
  }
  .btn-edit {
    background-color: #ffc107;
    color: #212529;
    padding: 5px 10px;
    text-decoration: none;
    border-radius: 4px;
    margin-right: 10px;
  }
  .btn-edit:hover {
    background-color: #e0a800;
  }
  .btn-delete {
    background-color: #dc3545;
    color: white;
    border: none;
    padding: 5px 10px;
    cursor: pointer;
    border-radius: 4px;
  }
  .btn-delete:hover {
    background-color: #c82333;
  }
  .article-content {
    line-height: 1.6;
    color: #333;
    margin-bottom: 30px;
  }
  .comments-section {
    margin-top: 30px;
  }
  .comments-section h2 {
    margin-top: 0;
  }
  .comment-list {
    border-top: 1px solid #eee;
    padding-top: 20px;
  }
  .comment-card {
    border-bottom: 1px solid #eee;
    padding: 15px 0;
  }
  .comment-card:last-child {
    border-bottom: none;
  }
  .comment-content {
    margin: 0 0 10px 0;
  }
  .comment-meta {
    color: #666;
    font-size: 0.85em;
  }
  .btn-delete-comment {
    background-color: #dc3545;
    color: white;
    border: none;
    padding: 3px 8px;
    cursor: pointer;
    border-radius: 3px;
    font-size: 0.8em;
  }
  .btn-delete-comment:hover {
    background-color: #c82333;
  }
  .add-comment {
    margin-top: 30px;
    padding-top: 20px;
    border-top: 1px solid #eee;
  }
  .add-comment h3 {
    margin-top: 0;
  }
  .add-comment .form-group {
    margin-bottom: 15px;
  }
  .add-comment label {
    display: block;
    margin-bottom: 5px;
    font-weight: bold;
  }
  .add-comment textarea {
    width: 100%;
    padding: 10px;
    border: 1px solid #ddd;
    border-radius: 4px;
    box-sizing: border-box;
  }
  .add-comment button {
    background-color: #007bff;
    color: white;
    border: none;
    padding: 10px 20px;
    border-radius: 4px;
    cursor: pointer;
  }
  .add-comment button:hover {
    background-color: #0056b3;
  }
</style>