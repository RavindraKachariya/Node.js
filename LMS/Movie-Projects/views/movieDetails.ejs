<%- include("layouts/header") %>

    <div class="bg-white shadow-xl rounded-lg p-6 flex flex-col md:flex-row gap-6">

        <img src="<%= movie.posterImage %>" class="md:w-1/3 rounded-lg">

        <div>
            <h1 class="text-3xl font-bold">
                <%= movie.title %>
            </h1>
            <p class="mt-2">Director: <%= movie.director %>
            </p>
            <p>Year: <%= movie.releaseYear %>
            </p>
            <p>Genre: <%= movie.genre %>
            </p>
            <p class="text-yellow-500 font-bold mt-2">⭐ <%= movie.rating %>
            </p>
            <p class="mt-4">
                <%= movie.description %>
            </p>

            <a href="/" class="inline-block mt-4 bg-gray-600 text-white px-4 py-2 rounded">
                Back
            </a>
        </div>

    </div>

    <%- include("layouts/footer") %>