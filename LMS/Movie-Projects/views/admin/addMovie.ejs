<%- include("../layouts/header") %>

    <h1 class="text-2xl font-bold mb-6">Add Movie</h1>

    <form action="/admin/add" method="POST" class="bg-white p-6 rounded shadow">

        <input name="title" placeholder="Title" class="border p-2 w-full mb-3">
        <input name="director" placeholder="Director" class="border p-2 w-full mb-3">
        <input name="releaseYear" placeholder="Year" class="border p-2 w-full mb-3">
        <input name="rating" placeholder="Rating" class="border p-2 w-full mb-3">
        <input name="genre" placeholder="Genre" class="border p-2 w-full mb-3">
        <input name="posterImage" placeholder="Poster Image URL" class="border p-2 w-full mb-3">
        <textarea name="description" placeholder="Description" class="border p-2 w-full mb-3"></textarea>

        <button class="bg-blue-500 text-white px-4 py-2 rounded">
            Add Movie
        </button>

    </form>

    <%- include("../layouts/footer") %>