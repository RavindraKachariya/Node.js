<%- include("../layouts/header") %>

    <h1 class="text-3xl font-bold mb-6">Edit Movie 🎬</h1>

    <div class="bg-white shadow-lg rounded-lg p-6 max-w-2xl mx-auto">

        <form action="/admin/edit/<%= movie._id %>" method="POST">

            <!-- Title -->
            <label class="block mb-2 font-semibold">Title</label>
            <input type="text" name="title" value="<%= movie.title %>" class="border p-2 w-full mb-4 rounded" required>

            <!-- Director -->
            <label class="block mb-2 font-semibold">Director</label>
            <input type="text" name="director" value="<%= movie.director %>" class="border p-2 w-full mb-4 rounded"
                required>

            <!-- Release Year -->
            <label class="block mb-2 font-semibold">Release Year</label>
            <input type="number" name="releaseYear" value="<%= movie.releaseYear %>"
                class="border p-2 w-full mb-4 rounded" required>

            <!-- Rating -->
            <label class="block mb-2 font-semibold">Rating</label>
            <input type="number" step="0.1" name="rating" value="<%= movie.rating %>"
                class="border p-2 w-full mb-4 rounded" required>

            <!-- Genre -->
            <label class="block mb-2 font-semibold">Genre</label>
            <input type="text" name="genre" value="<%= movie.genre %>" class="border p-2 w-full mb-4 rounded" required>

            <!-- Poster Image -->
            <label class="block mb-2 font-semibold">Poster Image URL</label>
            <input type="text" name="posterImage" value="<%= movie.posterImage %>"
                class="border p-2 w-full mb-4 rounded" required>

            <!-- Description -->
            <label class="block mb-2 font-semibold">Description</label>
            <textarea name="description" rows="4" class="border p-2 w-full mb-4 rounded"
                required><%= movie.description %></textarea>

            <!-- Buttons -->
            <div class="flex justify-between">
                <a href="/admin" class="bg-gray-500 text-white px-4 py-2 rounded hover:bg-gray-600">
                    Cancel
                </a>

                <button type="submit" class="bg-blue-600 text-white px-6 py-2 rounded hover:bg-blue-700">
                    Update Movie
                </button>
            </div>

        </form>

    </div>

    <%- include("../layouts/footer") %>