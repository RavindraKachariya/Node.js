<%- include("layouts/header") %>

    <h1 class="text-3xl font-bold mb-6 text-center">All Movies</h1>

    <form method="GET" action="/" class="mb-6 flex justify-center">
        <input type="text" name="search" placeholder="Search movie..." class="border p-2 w-1/3 rounded-l">
        <button class="bg-blue-500 text-white px-4 rounded-r">
            Search
        </button>
    </form>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

        <% movies.forEach(movie=> { %>
            <div class="bg-white shadow-lg rounded-lg p-4 hover:shadow-xl transition">
                <img src="<%= movie.posterImage %>" class="h-48 w-full object-cover rounded">
                <h2 class="text-xl font-semibold mt-3">
                    <%= movie.title %>
                </h2>
                <p class="text-gray-600">
                    <%= movie.genre %>
                </p>
                <p class="text-green-600 font-bold mt-1">⭐ <%= movie.rating %>
                </p>
                <a href="/movie/<%= movie._id %>"
                    class="block bg-blue-500 text-white text-center mt-3 py-2 rounded hover:bg-blue-600">
                    View Details
                </a>
            </div>
            <% }) %>

    </div>

    <%- include("layouts/footer") %>